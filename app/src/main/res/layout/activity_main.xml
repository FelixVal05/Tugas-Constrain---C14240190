<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F1F5F9"
        android:id="@+id/utama">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#0F172A"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="56dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txt_label_official"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="OFFICIAL PROFILE"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/img_logo" />

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Universitas Kristen Petra"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txt_label_official"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/img_logo" />

            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logopetra"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/txt_title" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header_deskripsi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#1E293B"
                android:padding="16dp"
                app:layout_constraintTop_toBottomOf="@id/txt_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/txt_deskripsi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Universitas Kristen Petra (UK Petra) adalah perguruan tinggi swasta nasional di Surabaya yang berdiri sejak tahun 1961, berkomitmen membentuk global socioleaders dengan standar akademik unggul[cite: 1]."
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sec_statistik_kiri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_modern_card_rounded"
            android:elevation="4dp"
            android:padding="18dp"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/sec_statistik_kanan"
            app:layout_constraintHorizontal_chainStyle="spread">

            <TextView
                android:id="@+id/lbl_didirikan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIDIRIKAN"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/val_didirikan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="2 Sept 1961"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/lbl_didirikan"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/sub_didirikan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Yayasan PPPK Petra"
                android:textColor="#475569"
                android:textSize="11sp"
                app:layout_constraintTop_toBottomOf="@id/val_didirikan"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sec_statistik_kanan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_modern_card_rounded"
            android:elevation="4dp"
            android:padding="18dp"
            app:layout_constraintTop_toTopOf="@id/sec_statistik_kiri"
            app:layout_constraintStart_toEndOf="@id/sec_statistik_kiri"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/lbl_mahasiswa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAHASISWA"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/val_mahasiswa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="7.000+"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/lbl_mahasiswa"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/sub_mahasiswa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Aktif  &amp; Dinamis"
                android:textColor="#0284C7"
                android:textSize="11sp"
                app:layout_constraintTop_toBottomOf="@id/val_mahasiswa"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_statistik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="sec_statistik_kiri,sec_statistik_kanan" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sec_lokasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/barrier_statistik"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txt_label_lokasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOKASI KAMPUS UTAMA"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_lokasi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_modern_card_rounded"
                android:elevation="2dp"
                android:padding="18dp"
                app:layout_constraintTop_toBottomOf="@id/txt_label_lokasi"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/ico_lokasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="22sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/txt_alamat1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Jl. Siwalankerto No. 121-131"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ico_lokasi"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txt_alamat2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Wonocolo, Surabaya, Jawa Timur, 60236"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/txt_alamat1"
                    app:layout_constraintStart_toStartOf="@id/txt_alamat1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sec_Fakultas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/sec_lokasi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txt_label_fakultas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FAKULTAS &amp; SEKOLAH UNGGULAN"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_fakultas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_modern_card_rounded"
                android:elevation="2dp"
                android:padding="20dp"
                app:layout_constraintTop_toBottomOf="@id/txt_label_fakultas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/fak1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Fakultas Teknologi Industri (FTI)"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fak1_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Informatika, Teknik Industri, Elektro, Mesin, dll."
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/fak1_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/div1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="14dp"
                    app:layout_constraintTop_toBottomOf="@id/fak1_desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fak2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="School of Business and Management"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/div1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fak2_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Manajemen Bisnis Internasional, Akutansi, Hotel Management"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/fak2_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/div2"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="14dp"
                    app:layout_constraintTop_toBottomOf="@id/fak2_desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fak3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Fakultas Humaniora dan Industri Kreatif"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/div2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fak3_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Desain Interior, DKV, Sastra, dan Creative Media"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/fak3_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/div3"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="14dp"
                    app:layout_constraintTop_toBottomOf="@id/fak3_desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fak4_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Fakultas Teknik Sipil dan Perencanaan"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/div3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fak4_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Teknik Sipil dan Arsitektur"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/fak4_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/div4"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    app:layout_constraintTop_toBottomOf="@id/fak4_desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sec_fasilitas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/sec_Fakultas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txt_label_fasilitas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FASILITAS UTAMA KAMPUS"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_fasilitas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_modern_card_rounded"
                android:elevation="2dp"
                android:padding="20dp"
                app:layout_constraintTop_toBottomOf="@id/txt_label_fasilitas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/fas1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="📚 Petra Library &amp; Cultural Center"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fas1_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pusat literatur digital dan koleksi arsip budaya nusantara."
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/fas1_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/fasdiv1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginVertical="12dp"
                    app:layout_constraintTop_toBottomOf="@id/fas1_desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fas2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="📚 Advanced Computer Labs"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/fasdiv1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fas2_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="💻 Laboratorium komputer spesifikasi tinggi untuk riset teknologi."
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/fas2_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/fasdiv2"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginVertical="12dp"
                    app:layout_constraintTop_toBottomOf="@id/fas2_desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fas3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="🏟 Petra Auditorium &amp; Indoor Arena"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/fasdiv2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/fas3_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Gedung serbaguna berkapasitas ribuan kursi untuk event nasional"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/fas3_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>